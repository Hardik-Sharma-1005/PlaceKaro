{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "studentProfiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "skills": {
      ".read": "auth != null && query.orderByChild === 'studentId' && query.equalTo === auth.uid",
      ".indexOn": [
        "studentId"
      ],
      "$id": {
        ".read": "auth != null && data.child('studentId').val() === auth.uid",
        ".write": "auth != null && (!data.exists() || data.child('studentId').val() === auth.uid) && (!newData.exists() || newData.child('studentId').val() === auth.uid)"
      }
    },

    "projects": {
      ".read": "auth != null && query.orderByChild === 'studentId' && query.equalTo === auth.uid",
      ".indexOn": [
        "studentId"
      ],
      "$id": {
        ".read": "auth != null && data.child('studentId').val() === auth.uid",
        ".write": "auth != null && (!data.exists() || data.child('studentId').val() === auth.uid) && (!newData.exists() || newData.child('studentId').val() === auth.uid)"
      }
    },

    "internships": {
      ".read": "auth != null && query.orderByChild === 'studentId' && query.equalTo === auth.uid",
      ".indexOn": [
        "studentId"
      ],
      "$id": {
        ".read": "auth != null && data.child('studentId').val() === auth.uid",
        ".write": "auth != null && (!data.exists() || data.child('studentId').val() === auth.uid) && (!newData.exists() || newData.child('studentId').val() === auth.uid)"
      }
    },

    "certifications": {
      ".read": "auth != null && query.orderByChild === 'studentId' && query.equalTo === auth.uid",
      ".indexOn": [
        "studentId"
      ],
      "$id": {
        ".read": "auth != null && data.child('studentId').val() === auth.uid",
        ".write": "auth != null && (!data.exists() || data.child('studentId').val() === auth.uid) && (!newData.exists() || newData.child('studentId').val() === auth.uid)"
      }
    },

    "achievements": {
      ".read": "auth != null && query.orderByChild === 'studentId' && query.equalTo === auth.uid",
      ".indexOn": [
        "studentId"
      ],
      "$id": {
        ".read": "auth != null && data.child('studentId').val() === auth.uid",
        ".write": "auth != null && (!data.exists() || data.child('studentId').val() === auth.uid) && (!newData.exists() || newData.child('studentId').val() === auth.uid)"
      }
    },

    "evidence": {
      ".read": "auth != null && query.orderByChild === 'studentId' && query.equalTo === auth.uid",
      ".indexOn": [
        "studentId"
      ],
      "$id": {
        ".read": "auth != null && data.child('studentId').val() === auth.uid",
        ".write": "auth != null && (!data.exists() || data.child('studentId').val() === auth.uid) && (!newData.exists() || newData.child('studentId').val() === auth.uid)"
      }
    },

    "jobs": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'placement' || (query.orderByChild === 'status' && query.equalTo === 'published') || (query.orderByChild === 'companyId' && query.equalTo === auth.uid))",
      ".indexOn": [
        "status",
        "companyId"
      ],

      "$jobId": {
        ".read": "auth != null && (data.child('companyId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'placement')",

        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'placement' && data.exists() && data.child('status').val() === 'pending_approval' && newData.child('status').val() === 'published' && newData.child('companyId').val() === data.child('companyId').val()) || (data.child('companyId').val() === auth.uid && newData.child('companyId').val() === auth.uid && (!data.exists() || newData.child('status').val() !== 'published')))"
      }
    },

    "jobRequirements": {
      "$jobId": {
        ".read": "auth != null && (root.child('jobs').child($jobId).child('companyId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'placement')",
        ".write": "auth != null && root.child('jobs').child($jobId).child('companyId').val() === auth.uid"
      }
    },

    "pisConfigurations": {
      "$jobId": {
        ".read": "auth != null && (root.child('jobs').child($jobId).child('companyId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'placement')",
        ".write": "auth != null && root.child('jobs').child($jobId).child('companyId').val() === auth.uid"
      }
    },

    "applications": {
      ".read": "auth != null && query.orderByChild === 'studentId' && query.equalTo === auth.uid",
      ".indexOn": [
        "studentId"
      ]
    },

    "notifications": {
      ".read": "auth != null && query.orderByChild === 'userId' && query.equalTo === auth.uid",
      ".indexOn": [
        "userId"
      ]
    }
  }
}